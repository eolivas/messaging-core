<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure adapter package: the Batch Processing provider shell (task 20.3). It plugs into
    the Domain ports (IMessagingProvider, IMessagePublisher, IMessageConsumerHost) and reuses the
    Application lifecycle state machine. Dependencies point inward only: it references
    Messaging.Abstractions (Domain ports) and Messaging (Application); nothing in Domain/Application
    references this package. The batch mechanics behind the shallow ports are owned by a later spec.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Messaging.Abstractions\Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\Messaging\Messaging.csproj" />
  </ItemGroup>

  <!--
    Structured logging via ILogger<T> (Microsoft.Extensions.Logging.Abstractions), pinned to the
    exact 8.0.x patch used by the other Infrastructure packages (no open ranges). The adapter logs
    its pull/checkpoint lifecycle; it never logs raw payloads or secrets.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
