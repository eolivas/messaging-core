<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Messaging.Abstractions\Messaging.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Application layer. The DI registration surfaces (use-what-you-need) and the startup
    validation/resolution hosted glue depend only on the Microsoft *abstractions* packages —
    IServiceCollection, IHostedService, ILogger — never on the concrete hosting/DI containers.
    This keeps the inward-dependency rule intact: the Application layer composes ports without
    taking a dependency on any concrete framework host or on a concrete provider assembly. Pinned
    to exact 8.0.x patches (no open ranges), aligned with the other packages in the solution.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
